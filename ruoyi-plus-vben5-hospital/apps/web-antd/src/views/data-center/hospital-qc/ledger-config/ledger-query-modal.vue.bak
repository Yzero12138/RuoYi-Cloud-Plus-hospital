<script setup lang="ts">
import type { HospitalQcSqlTestResult } from '#/api/data-center/hospital-qc/ledger-query/model';

import { computed, ref } from 'vue';

import { useVbenModal } from '@vben/common-ui';
import { $t } from '@vben/locales';
import { addFullName, cloneDeep, getPopupContainer, listToTree } from '@vben/utils';

import { useVbenForm } from '#/adapter/form';
import {
  hospitalQcLedgerQueryAdd,
  hospitalQcLedgerQueryInfo,
  hospitalQcLedgerQueryTestSql,
  hospitalQcLedgerQueryUpdate,
} from '#/api/data-center/hospital-qc/ledger-query';
import { hospitalQcDatasourceOptions } from '#/api/data-center/hospital-qc/datasource';
import { deptList } from '#/api/system/dept';
import { defaultFormValueGetter, useBeforeCloseDiff } from '#/utils/popup';

import { queryModalSchema } from './data';

import { message } from 'ant-design-vue';
import dayjs from 'dayjs';

// 字段映射项类型
interface FieldMappingItem {
  id: string;
  alias: string;
  label: string;
  visible: boolean;
  order: number;
  width?: number;
}

const emit = defineEmits<{ reload: [] }>();

const isUpdate = ref(false);
const testResult = ref<HospitalQcSqlTestResult>();
const fieldMappings = ref<FieldMappingItem[]>([]);
const editingKey = ref<string>('');

const title = computed(() => {
  return isUpdate.value ? $t('pages.common.edit') : $t('pages.common.add');
});

const deptNameMap = new Map<number, string>();

const [BasicForm, formApi] = useVbenForm({
  commonConfig: {
    labelWidth: 92,
  },
  schema: queryModalSchema(),
  showDefaultActions: false,
  wrapperClass: 'grid-cols-2',
});

const sampleColumns = computed(() => {
  return (testResult.value?.columns ?? []).map((col) => ({
    title: col,
    dataIndex: col,
    key: col,
    ellipsis: true,
    width: 180,
  }));
});

// 字段映射表格列
const mappingColumns = [
  { title: 'SQL别名', dataIndex: 'alias', key: 'alias', width: 150 },
  { title: '显示标签', dataIndex: 'label', key: 'label', width: 150 },
  { title: '可见', dataIndex: 'visible', key: 'visible', width: 80 },
  { title: '排序', dataIndex: 'order', key: 'order', width: 80 },
  { title: '操作', dataIndex: 'action', key: 'action', width: 120 },
];

function toOptionalNumber(value: unknown) {
  if (value === null || value === undefined || value === '') {
    return undefined;
  }
  const parsed = Number(value);
  return Number.isNaN(parsed) ? undefined : parsed;
}

function formatSqlText(sql?: string) {
  if (!sql) {
    return sql;
  }
  return sql
    .replace(/\s+/g, ' ')
    .replace(/\b(select|from|where|group by|order by|left join|right join|inner join|outer join|and|or)\b/gi, (keyword) => {
      const upper = keyword.toUpperCase();
      return ['AND', 'OR'].includes(upper) ? `\n  ${upper}` : `\n${upper}`;
    })
    .trim();
}

// 从SQL测试列生成字段映射（只填入alias，label为空让用户填写）
function generateFieldMappingsFromColumns(columns: string[]) {
  const existingAliases = new Set(fieldMappings.value.map(m => m.alias));
  const newMappings = columns
    .filter(col => !existingAliases.has(col))
    .map((col, index) => ({
      id: `${Date.now()}_${index}`,
      alias: col,
      label: '', // 默认为空，让用户填写中文映射
      visible: true,
      order: fieldMappings.value.length + index + 1,
    }));
  fieldMappings.value = [...fieldMappings.value, ...newMappings];
  // 自动进入编辑模式让用户填写label
  if (newMappings.length > 0) {
    editingKey.value = newMappings[0].id;
  }
}

// 删除字段映射

// 添加字段映射
function addFieldMapping() {

// 添加字段映射

// 添加字段映射
function generateFieldMappingsFromColumns(columns: string[]) {
  const existingAliases = new Set(fieldMappings.value.map(m => m.alias));
  const newMappings = columns
    .filter(col => !existingAliases.has(col))
    .map((col, index) => ({
      id: `${Date.now()}_${index}`,
      alias: col,
      label: col,
      visible: true,
      order: fieldMappings.value.length + index + 1,
    }));
  fieldMappings.value = [...fieldMappings.value, ...newMappings];
}

// 添加字段映射
function addFieldMapping() {
  const newMapping: FieldMappingItem = {
    id: `${Date.now()}`,
    alias: '',
    label: '',
    visible: true,
    order: fieldMappings.value.length + 1,
  };
  fieldMappings.value.push(newMapping);
  editingKey.value = newMapping.id;
}

// 删除字段映射
function removeFieldMapping(id: string) {
  fieldMappings.value = fieldMappings.value.filter(m => m.id !== id);
}

// 编辑字段映射
function editFieldMapping(record: FieldMappingItem) {
  editingKey.value = record.id;
}

// 保存字段映射
function saveFieldMapping(_record: FieldMappingItem) {
  editingKey.value = '';
  // 更新到表单
  updateFieldMappingToForm();
}

// 取消编辑
function cancelEdit() {
  editingKey.value = '';
}

// 更新字段映射到表单
function updateFieldMappingToForm() {
  const sortedMappings = [...fieldMappings.value]
    .filter(m => m.alias && m.label)
    .sort((a, b) => a.order - b.order);
  formApi.setFieldValue('detailFieldMapping', JSON.stringify(sortedMappings));
}

// 加载字段映射
function loadFieldMappings(jsonStr?: string) {
  if (!jsonStr) {
    fieldMappings.value = [];
    return;
  }
  try {
    const parsed = JSON.parse(jsonStr);
    if (Array.isArray(parsed)) {
      fieldMappings.value = parsed.map((m, index) => ({
        id: `${Date.now()}_${index}`,
        alias: m.alias || '',
        label: m.label || '',
        visible: m.visible !== false,
        order: m.order || index + 1,
        width: m.width,
      }));
    }
  } catch {
    fieldMappings.value = [];
  }
}

async function setupDeptSelect() {
  const deptArray = await deptList({});
  const treeData = listToTree(deptArray, { id: 'deptId', pid: 'parentId' });
  addFullName(treeData, 'deptName', ' / ');
  deptNameMap.clear();

  const fillMap = (nodes?: any[]) => {
    if (!nodes) {
      return;
    }
    nodes.forEach((node) => {
      if (node?.deptId) {
        deptNameMap.set(node.deptId, node.fullName ?? node.deptName);
      }
      if (node?.children?.length) {
        fillMap(node.children);
      }
    });
  };
  fillMap(treeData);

  formApi.updateSchema([
    {
      componentProps: {
        fieldNames: {
          label: 'deptName',
          value: 'deptId',
        },
        getPopupContainer,
        listHeight: 300,
        showSearch: true,
        treeData,
        treeDefaultExpandAll: false,
        treeLine: { showLeafIcon: false },
        treeNodeFilterProp: 'deptName',
        treeNodeLabelProp: 'fullName',
        onChange: (value: number | null) => {
          if (!value) {
            formApi.setFieldValue('deptName', undefined);
            return;
          }
          formApi.setFieldValue('deptName', deptNameMap.get(value));
        },
      },
      fieldName: 'deptId',
    },
  ]);
}

async function setupDatasourceSelect() {
  const options = await hospitalQcDatasourceOptions();
  formApi.updateSchema([
    {
      componentProps: {
        options: options.map((item) => ({
          label: item.label,
          value: Number(item.value),
        })),
        onChange: (value: number | string | undefined) => {
          formApi.setFieldValue('datasourceId', toOptionalNumber(value));
        },
      },
      fieldName: 'datasourceId',
    },
  ]);
}

const { onBeforeClose, markInitialized, resetInitialized } = useBeforeCloseDiff({
  initializedGetter: defaultFormValueGetter(formApi),
  currentGetter: defaultFormValueGetter(formApi),
});

const [BasicModal, modalApi] = useVbenModal({
  fullscreenButton: false,
  onBeforeClose,
  onClosed: handleClosed,
  onConfirm: handleConfirm,
  onOpenChange: async (isOpen) => {
    if (!isOpen) {
      return null;
    }
    modalApi.modalLoading(true);
    testResult.value = undefined;
    fieldMappings.value = [];

    const { id } = modalApi.getData() as { id?: number };
    isUpdate.value = !!id;

    await Promise.all([setupDeptSelect(), setupDatasourceSelect()]);

    if (id) {
      const record = await hospitalQcLedgerQueryInfo(id);
      await formApi.setValues({
        ...record,
        id: toOptionalNumber(record.id),
        deptId: toOptionalNumber(record.deptId),
        datasourceId: toOptionalNumber(record.datasourceId),
        status: toOptionalNumber(record.status) ?? 0,
      });
      // 加载字段映射
      loadFieldMappings(record.detailFieldMapping);
    } else {
      await formApi.setValues({
        status: 0,
      });
    }

    await markInitialized();
    modalApi.modalLoading(false);
  },
});

async function handleConfirm() {
  try {
    modalApi.lock(true);
    const { valid } = await formApi.validate();
    if (!valid) {
      return;
    }
    
    // 更新字段映射到表单
    updateFieldMappingToForm();
    
    const data = cloneDeep(await formApi.getValues());
    const payload = {
      ...data,
      id: toOptionalNumber(data.id),
      deptId: toOptionalNumber(data.deptId),
      datasourceId: toOptionalNumber(data.datasourceId),
      status: toOptionalNumber(data.status) ?? 0,
    };
    await (isUpdate.value
      ? hospitalQcLedgerQueryUpdate(payload)
      : hospitalQcLedgerQueryAdd(payload));
    resetInitialized();
    emit('reload');
    modalApi.close();
  } catch (error) {
    console.error(error);
  } finally {
    modalApi.lock(false);
  }
}

async function handleClosed() {
  await formApi.resetForm();
  testResult.value = undefined;
  fieldMappings.value = [];
  editingKey.value = '';
  resetInitialized();
}

async function handleFormatSql() {
  const values = await formApi.getValues();
  await formApi.setValues({
    countSql: formatSqlText(values.countSql),
    detailSql: formatSqlText(values.detailSql),
  });
}

async function handleTestSql() {
  const values = cloneDeep(await formApi.getValues());
  const data = {
    ...values,
    deptId: toOptionalNumber(values.deptId),
    datasourceId: toOptionalNumber(values.datasourceId),
    startTime: dayjs().startOf('month' as any).format('YYYY-MM-DD HH:mm:ss'),
    endTime: dayjs().endOf('month' as any).format('YYYY-MM-DD HH:mm:ss'),
  };
  const result = await hospitalQcLedgerQueryTestSql(data);
  testResult.value = result;
  if (result.success) {
    message.success(result.message ?? 'SQL 测试成功');
    // 自动生成字段映射
    if (result.columns?.length) {
      generateFieldMappingsFromColumns(result.columns);
    }
  } else {
    message.error(result.message ?? 'SQL 测试失败');
  }
}
</script>

<template>
  <BasicModal :title="title" class="w-[1100px]">
    <div class="mb-3 flex gap-2">
      <a-button @click="handleFormatSql">格式化 SQL</a-button>
      <a-button
        type="primary"
        v-access:code="['data-center:hospital-qc:ledger-query:test']"
        @click="handleTestSql"
      >
        测试 SQL
      </a-button>
    </div>

    <BasicForm />

    <!-- 字段映射配置 -->
    <div class="mt-4">
      <div class="flex items-center justify-between mb-2">
        <a-button type="dashed" size="small" @click="addFieldMapping">
          + 添加字段
        </a-button>
        <a-button type="dashed" size="small" @click="addFieldMapping">
          <template #icon><plus-outlined /></template>
          添加字段
        </a-button>
      </div>
      <a-table
        :columns="mappingColumns"
        :data-source="fieldMappings"
        :pagination="false"
        size="small"
        bordered
        row-key="id"
        :scroll="{ y: 200 }"
      >
        <template #bodyCell="{ column, record }">
          <template v-if="column.dataIndex === 'alias'">
            <a-input
              v-if="editingKey === record.id"
              v-model:value="record.alias"
              size="small"
              placeholder="SQL别名"
            />
            <span v-else>{{ record.alias }}</span>
          </template>
          
          <template v-else-if="column.dataIndex === 'label'">
            <a-input
              v-if="editingKey === record.id"
              v-model:value="record.label"
              size="small"
              placeholder="显示标签"
            />
            <span v-else>{{ record.label }}</span>
          </template>
          
          <template v-else-if="column.dataIndex === 'visible'">
            <a-switch
              v-model:checked="record.visible"
              size="small"
              :disabled="editingKey !== record.id"
            />
          </template>
          
          <template v-else-if="column.dataIndex === 'order'">
            <a-input-number
              v-if="editingKey === record.id"
              v-model:value="record.order"
              size="small"
              :min="1"
              style="width: 60px"
            />
            <span v-else>{{ record.order }}</span>
          </template>
          
          <template v-else-if="column.dataIndex === 'action'">
            <span v-if="editingKey === record.id">
              <a-button type="link" size="small" @click="saveFieldMapping(record)">保存</a-button>
              <a-button type="link" size="small" danger @click="cancelEdit">取消</a-button>
            </span>
            <span v-else>
              <a-button type="link" size="small" @click="editFieldMapping(record)">编辑</a-button>
              <a-button type="link" size="small" danger @click="removeFieldMapping(record.id)">删除</a-button>
            </span>
          </template>
        </template>
      </a-table>
      <div class="text-xs text-gray-400 mt-1">
        提示: SQL测试成功后会自动识别列名，可配置显示标签和可见性
      </div>
    </div>

    <div v-if="testResult" class="mt-3">
      <a-alert
        :type="testResult.success ? 'success' : 'error'"
        :message="`${testResult.message ?? ''}，耗时 ${testResult.elapsedMs ?? 0}ms，计数 ${testResult.countValue ?? 0}`"
        show-icon
      />
      <a-table
        v-if="(testResult.sampleRows?.length ?? 0) > 0"
        :columns="sampleColumns"
        :data-source="testResult.sampleRows"
        :pagination="false"
        class="mt-2"
        size="small"
        bordered
        :scroll="{ x: 900, y: 240 }"
      />
    </div>
  </BasicModal>
</template>

<style scoped lang="scss">
:deep(.ant-table-cell) {
  padding: 4px 8px !important;
}
</style>
